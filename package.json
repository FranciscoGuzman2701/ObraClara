{
  "name": "obraclara",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @obraclara/db migrate",
    "db:seed": "pnpm --filter @obraclara/db seed",
    "db:demo": "pnpm --filter @obraclara/db demo"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
