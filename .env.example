# Base de datos (el usuario es dueño del esquema; la API baja a rol oc_app por transacción)
DATABASE_URL=postgres://obraclara:obraclara@localhost:5432/obraclara
TEST_DATABASE_URL=postgres://obraclara:obraclara@localhost:5432/obraclara_test

# API
PORT=3001
JWT_SECRET=cambia-esto-en-produccion
ALLOW_DEV_LOGIN=true

# Almacenamiento de evidencias (MinIO en local, S3/R2 en producción)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=obraclara-evidencias
S3_ACCESS_KEY_ID=obraclara
S3_SECRET_ACCESS_KEY=obraclara-secret

# Web
OBRACLARA_API_URL=http://localhost:3001
OBRACLARA_DEV_EMAIL=director@demo.mx

# App de campo (Expo lee variables EXPO_PUBLIC_*)
EXPO_PUBLIC_API_URL=http://localhost:3001
