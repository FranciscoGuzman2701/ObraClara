<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ObraClara.Apu.Desktop.App"
             RequestedThemeVariant="Light">
  <!--
    Tema "ObraClara clásico": la apariencia de los programas de precios unitarios de escritorio
    (grillas densas, encabezados de color, renglones alternos, barra de totales), con la paleta
    propia de ObraClara: azul pizarra + ámbar.
  -->
  <Application.Resources>
    <Color x:Key="OcMarca">#17375E</Color>
    <Color x:Key="OcMarcaClara">#2E5C8A</Color>
    <Color x:Key="OcAcento">#F2A900</Color>
    <Color x:Key="OcFondo">#E9EEF4</Color>
    <SolidColorBrush x:Key="OcMarcaBrush" Color="{StaticResource OcMarca}" />
    <SolidColorBrush x:Key="OcMarcaClaraBrush" Color="{StaticResource OcMarcaClara}" />
    <SolidColorBrush x:Key="OcAcentoBrush" Color="{StaticResource OcAcento}" />
    <SolidColorBrush x:Key="OcFondoBrush" Color="{StaticResource OcFondo}" />
    <SolidColorBrush x:Key="OcBordeBrush" Color="#C9D4E0" />
    <SolidColorBrush x:Key="OcAlternoBrush" Color="#F2F6FA" />
    <SolidColorBrush x:Key="OcTextoTenueBrush" Color="#5A6B7D" />

    <!-- recursos del DataGrid (tema Fluent) sustituidos por la paleta -->
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#2E5C8A" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="#3A6E9F" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#17375E" />
    <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#D5DEE8" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#BFD9F2" />
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#D6E5F3" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#B3D1EE" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#CCDFF1" />
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="#F2A900" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="#F2A900" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="#F2A900" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource OcFondoBrush}" />
    </Style>

    <!-- grillas densas: renglón de 26 px, encabezado en negritas sobre azul -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource OcBordeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RowHeight" Value="26" />
      <Setter Property="ColumnHeaderHeight" Value="28" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E1E8F0" />
      <Setter Property="VerticalGridLinesBrush" Value="#E1E8F0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="SeparatorBrush" Value="#5B83AB" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridRow.alterno">
      <Setter Property="Background" Value="{StaticResource OcAlternoBrush}" />
    </Style>

    <!-- números alineados a la derecha con dígitos tabulares -->
    <Style Selector="TextBlock.num">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>

    <!-- pestañas tipo carpeta -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="#D3DDE8" />
      <Setter Property="Foreground" Value="#2B3A4A" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource OcMarcaBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource OcAcentoBrush}" />
    </Style>

    <!-- barra de herramientas: botones planos con la tecla de función resaltada -->
    <Style Selector="Button.herramienta">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.herramienta:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D6E4F2" />
    </Style>
    <Style Selector="Border.tecla">
      <Setter Property="Background" Value="{StaticResource OcMarcaBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tecla > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Application.Styles>
</Application>
